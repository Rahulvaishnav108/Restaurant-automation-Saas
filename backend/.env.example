# ======================================================
# QR CODE CONFIGURATION
# ======================================================

# crypto.randomBytes(32)
QR_TOKEN_LENGTH_BYTES=32

ENABLE_QR_REGENERATION=true

QR_DOWNLOAD_FORMAT=png

QR_IMAGE_SIZE=1024

QR_ERROR_CORRECTION=H

QR_STORAGE_PATH=uploads/qrcodes

